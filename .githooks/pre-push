#!/bin/sh
# Hook pre-push: recusa qualquer push cujo destino seja a branch `main`, em QUALQUER remoto
# (origin, outro nome ou URL direta), inclusive atualização forçada e exclusão.
#
# Ative com `npm run hooks:install` (ver docs/BRANCH_POLICY.md). O hook é uma proteção contra
# ENGANOS, não um controle de segurança: `git push --no-verify`, outro clone sem o hook ou a
# interface web do GitHub não passam por ele. A main só deve mudar por merge de PR aprovado.
#
# Entrada (padrão do Git, uma linha por ref): <ref local> <sha local> <ref remota> <sha remoto>

remote_name="$1"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue

  # Comparação sem diferenciar maiúsculas: `Main`/`MAIN` também é recusado (conservador).
  ref_lower=$(printf '%s' "$remote_ref" | tr '[:upper:]' '[:lower:]')
  [ "$ref_lower" = "refs/heads/main" ] || continue

  case "$local_sha" in
    *[!0]*)
      action="atualização"
      case "$remote_sha" in
        *[!0]*)
          # Se o commit remoto não é ancestral do local, seria um push forçado (reescrita).
          if git cat-file -e "$remote_sha^{commit}" 2>/dev/null &&
            ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            action="atualização FORÇADA (reescrita de histórico)"
          fi
          ;;
      esac
      ;;
    *) action="EXCLUSÃO" ;;
  esac

  echo "pre-push: bloqueado — $action de '$remote_ref' no remoto '$remote_name' (origem local: $local_ref)." >&2
  blocked=1
done

if [ "$blocked" -ne 0 ]; then
  cat >&2 <<'EOF'
pre-push: a branch main não recebe push direto. Publique uma branch de feature e abra um PR
          (docs/BRANCH_POLICY.md). Nenhuma ref foi enviada neste push.
EOF
  exit 1
fi

exit 0
